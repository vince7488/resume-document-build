# ==============================================================================
# Resume Document Build - Git Ignore Configuration
# Explicitly excludes project-specific build artifacts, proprietary font files,
# candidate PII / compiled output PDFs, review media, and environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project Build & Export Targets
# ------------------------------------------------------------------------------
# Standalone compiled export directory generated via `npm run export:html` or UI
resume-build/
dist/
build/
out/
exports/

# Client-side generated zip archives
*.zip
*.tar.gz

# ------------------------------------------------------------------------------
# 2. Proprietary & Offline Font Files (Licensing & Privacy)
# ------------------------------------------------------------------------------
# Manually injected TTF/OTF/WOFF font binaries must never be published publicly.
# Preserves documentation and directory structure while ignoring all font binaries.
assets/fonts/*
!assets/fonts/README.md
!assets/fonts/.gitkeep
*.ttf
*.otf
*.woff
*.woff2
*.eot

# ------------------------------------------------------------------------------
# 3. Compiled Resume Outputs (PDFs & Rendered Documents)
# ------------------------------------------------------------------------------
# Personal identifying information (PII), clearance details, and compiled resumes
*.pdf

# ------------------------------------------------------------------------------
# 4. Local Review Screenshots & Visual Regression Media
# ------------------------------------------------------------------------------
# Headless Chrome test captures, UI audit screenshots, and video recordings
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.mp4
/*.mov
screenshots/
recording/

# ------------------------------------------------------------------------------
# 5. Tailored Applications, Drafts & Confidential Materials
# ------------------------------------------------------------------------------
# Company-specific application variants, custom cover letters, and notes
private/
drafts/
tailored/
cover-letters/
submissions/
notes/
*.draft.*
*.private.*
*confidential*

# ------------------------------------------------------------------------------
# 6. Environment Variables, Keys & Credentials
# ------------------------------------------------------------------------------
# API keys for agentic AI pipelines and local credentials
.env
.env.*
!.env.example
*.local
credentials.json
secrets/
*.pem
*.key

# ------------------------------------------------------------------------------
# 7. Package Dependencies & Runtime Logs
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 8. Temporary & Scratch Files
# ------------------------------------------------------------------------------
temp/
tmp/
scratch/
*.tmp
.cache/
.tempmediaStorage/

# ------------------------------------------------------------------------------
# 9. OS & IDE System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db

# IDEs & AI Agent configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
.gemini/
.agents/
